# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Browser keys (public, safe with Row Level Security). Also add them as GitHub repository
# secrets VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY so the deploy build uses Supabase.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# Only for `npm run db:push` on your own machine (Project settings > Database > Connection string).
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
